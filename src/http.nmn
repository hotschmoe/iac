// Allocation-free HTTP/1.0 helpers for Amber Scout.

const fmt = @import("std/fmt.nmn");
const mem = @import("std/mem.nmn");
const testing = @import("std/testing.nmn");
const linux_sock = @import("linux_sock.nmn");

pub const Method = enum {
    get,
    other,
};

pub const Request = struct {
    method: Method,
    path: []const u8,
    query: []const u8,
};

fn byteEq(a: []const u8, b: []const u8) bool {
    return mem.eqlScalar(a, b);
}

pub fn parseRequest(buf: []const u8) ?Request {
    const line_end: usize = mem.indexOf(buf, "\r\n") orelse return null;
    const line: []const u8 = buf[0..line_end];
    const first_space: usize = mem.indexOfByte(line, ' ') orelse return null;
    if (first_space == 0) return null;
    const rest_start: usize = first_space + @as(usize, 1);
    if (rest_start >= line.len) return null;
    const second_relative: usize = mem.indexOfByte(line[rest_start..], ' ') orelse return null;
    const second_space: usize = rest_start + second_relative;
    if (second_space == rest_start) return null;

    const version_start: usize = second_space + @as(usize, 1);
    if (version_start >= line.len) return null;
    if (!startsWith(line[version_start..], "HTTP/")) return null;

    const raw_target: []const u8 = line[rest_start..second_space];
    var path: []const u8 = raw_target;
    var query: []const u8 = raw_target[raw_target.len..raw_target.len];
    if (mem.indexOfByte(raw_target, '?')) |question| {
        path = raw_target[0..question];
        const query_start: usize = question + @as(usize, 1);
        query = raw_target[query_start..raw_target.len];
    }
    if (path.len == 0) return null;

    const method_bytes: []const u8 = line[0..first_space];
    const method: Method = if (byteEq(method_bytes, "GET")) .get else .other;
    return Request{
        .method = method,
        .path = path,
        .query = query,
    };
}

fn startsWith(bytes: []const u8, prefix: []const u8) bool {
    if (prefix.len > bytes.len) return false;
    return byteEq(bytes[0..prefix.len], prefix);
}

pub fn queryGet(query: []const u8, key: []const u8, out: []u8) usize {
    var start: usize = 0;
    while (start <= query.len) {
        const tail: []const u8 = query[start..query.len];
        const amp_relative: usize = mem.indexOfByte(tail, '&') orelse tail.len;
        const pair: []const u8 = tail[0..amp_relative];
        if (mem.indexOfByte(pair, '=')) |eq| {
            const pair_key: []const u8 = pair[0..eq];
            if (byteEq(pair_key, key)) {
                const value_start: usize = eq + @as(usize, 1);
                const value: []const u8 = pair[value_start..pair.len];
                var count: usize = value.len;
                if (count > out.len) count = out.len;
                mem.copyScalar(out.ptr, value.ptr, count);
                return count;
            }
        }
        if (amp_relative == tail.len) break;
        start = start + amp_relative + @as(usize, 1);
    }
    return 0;
}

fn formatNumber(out: []u8, value: anytype) []const u8 {
    var cursor: mem.WriteCursor = undefined;
    cursor.init(out);
    _ = fmt.format(&cursor, "{d}", .{value}) catch return out[0..0];
    return cursor.written();
}

fn expectNoRequest(buf: []const u8) testing.Error!void {
    if (parseRequest(buf)) |_| {
        return error.TestUnexpectedResult;
    }
}

pub fn writeHttp(fd: u32, status: u16, reason: []const u8, content_type: []const u8, body: []const u8) bool {
    var status_storage: [8]u8 = undefined;
    const status_text: []const u8 = formatNumber(status_storage[0..], status);
    if (status_text.len == 0) return false;

    var length_storage: [32]u8 = undefined;
    const length_text: []const u8 = formatNumber(length_storage[0..], body.len);
    if (length_text.len == 0) return false;

    if (!linux_sock.sendAll(fd, "HTTP/1.0 ")) return false;
    if (!linux_sock.sendAll(fd, status_text)) return false;
    if (!linux_sock.sendAll(fd, " ")) return false;
    if (!linux_sock.sendAll(fd, reason)) return false;
    if (!linux_sock.sendAll(fd, "\r\nContent-Type: ")) return false;
    if (!linux_sock.sendAll(fd, content_type)) return false;
    if (!linux_sock.sendAll(fd, "\r\nContent-Length: ")) return false;
    if (!linux_sock.sendAll(fd, length_text)) return false;
    if (!linux_sock.sendAll(fd, "\r\nConnection: close\r\n\r\n")) return false;
    return linux_sock.sendAll(fd, body);
}

test "parseRequest GET path without query" {
    const req: Request = parseRequest("GET / HTTP/1.0\r\nHost: x\r\n\r\n") orelse unreachable;
    try testing.expectEqual(Method, .get, req.method);
    try testing.expect(byteEq(req.path, "/"));
    try testing.expectEqual(usize, 0, req.query.len);
}

test "parseRequest GET path and query" {
    const req: Request = parseRequest("GET /cmd?c=MOVE&d=E HTTP/1.0\r\n\r\n") orelse unreachable;
    try testing.expectEqual(Method, .get, req.method);
    try testing.expect(byteEq(req.path, "/cmd"));
    try testing.expect(byteEq(req.query, "c=MOVE&d=E"));
}

test "parseRequest marks non-GET as other" {
    const req: Request = parseRequest("POST /cmd HTTP/1.0\r\n\r\n") orelse unreachable;
    try testing.expectEqual(Method, .other, req.method);
    try testing.expect(byteEq(req.path, "/cmd"));
}

test "parseRequest fails without complete request line" {
    try expectNoRequest("GET / HTTP/1.0\n");
    try expectNoRequest("GET / HTTP/1.0");
    try expectNoRequest("GET / \r\n");
}

test "optional Request == null is true for incomplete lines" {
    try testing.expect(parseRequest("GET / HTTP/1.0") == null);
}

test "queryGet returns requested value" {
    var out: [16]u8 = undefined;
    const count: usize = queryGet("c=MOVE&d=E", "d", out[0..]);
    try testing.expectEqual(usize, 1, count);
    try testing.expect(byteEq(out[0..count], "E"));
}

test "queryGet truncates without overflow" {
    var out: [4]u8 = undefined;
    const count: usize = queryGet("c=HARVEST", "c", out[0..]);
    try testing.expectEqual(usize, 4, count);
    try testing.expect(byteEq(out[0..count], "HARV"));
}

test "queryGet missing returns zero" {
    var out: [8]u8 = undefined;
    try testing.expectEqual(usize, 0, queryGet("c=SCAN", "d", out[0..]));
}
